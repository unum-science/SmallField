#!/usr/bin/env bash
#
# SmallField pre-commit: enforce the house style on staged changes before they land.
#
# Each check inspects only the ADDED lines of a staged file, so legacy code migrates on its own
# schedule while no new violation sneaks in, and each prints the specific reason when it fires.
# The dispatch loop at the bottom diffs every staged file exactly once and hands the added lines
# to each check through the `file` / `added` globals - the checks themselves are grep one-liners.
# Configuring the CMake build arms these hooks; see the `core.hooksPath` block in CMakeLists.txt.
#
# Each check below carries its own rationale, so this file is the rulebook. When a rule needs to
# bend for a legitimate one-off, edit the rule and document the bend rather than reaching for the
# bypass; there is deliberately no in-band escape comment.
#
# Three rules matter here but cannot be matched by a regex, so they live as prose and in review:
#
#   Fill a caller-owned output rather than returning a container. Write `fill_x_into(input, out)`
#   with `out.clear()`, not `std::vector<T> compute_x(input)`, and hoist the scratch above the
#   loop that consumes it so a growth phase happens once.
#
#   A comment that asserts a measurable fact is a test. If a comment states a property, either the
#   code enforces it or the comment goes. Every stale assertion found in this tree redirected real
#   work - a comment claiming shared memory above a kernel-local array, a docstring describing a
#   three-stream pipeline above code that creates one stream, a header claiming 84 % pattern
#   coverage against a measured 86.8 %.
#
#   A performance number states its corpus, its sample size, and its weighting. A microbenchmark
#   of an isolated access pattern is not an expected result: the 6.9x bounds-read figure measured
#   here was real at 128 atoms, which is 0.1 % of PubChem, against 2.47x weighted by the real
#   distribution and under 3 % end to end. Compare A against B inside one run, since absolute
#   throughput drifts 10-15 % on a loaded machine while the ratio does not. Report the tail, not
#   only the median. Say what you could not measure.
#
# Bypass knowingly (you almost never should) with: git commit --no-verify
#
# Portability: bash 3.2 and POSIX grep/sed are enough, so a stock macOS shell and Git for Windows
# both run this unchanged. No `mapfile`, no associative arrays, no `${var,,}`, and no `;;&` case
# fallthrough - that one is bash 4, and macOS has shipped bash 3.2 since 2007, where it is a parse
# error that kills the whole script rather than one check. Diff text is stripped of CR before
# matching, so a CRLF worktree cannot defeat the `$`-anchored patterns even where `.gitattributes`
# is ignored. Process substitution is avoided in favour of a plain file redirect, since `/dev/fd`
# is the flakiest part of MSYS.
#
# `.githooks/selftest` feeds known-good and known-bad fixtures through this file and asserts the
# verdict. Run it after touching any check; a rule that rejects prose describing it is the failure
# mode these checks keep having.

set -u
# Exported so child greps actually see it - a bare assignment sets a shell variable that no
# subprocess inherits, which made the byte-wise claim below false for every check in this file.
export LC_ALL=C

failures=0

# Prints the reason and the first offending lines, and marks the commit rejected. The count is what
# `selftest` reads to assert that exactly one check fired, which is what turns a rejection test into
# a false-positive test as well.
fail() { # fail <matches> <message-line>...
    local matches=$1
    shift
    local line
    for line in "$@"; do echo "pre-commit: $line"; done
    printf '%s\n' "$matches" | head -5
    failures=$((failures + 1))
}

# Input hygiene. Every check reads `+`-prefixed diff text, and the `+` is preserved by all three so
# the anchored patterns keep working.
#
# The split matters because the house style requires a rationale comment above each rule, and every
# rationale names the construct its rule bans: a comment reading "a thread_local cache would hide
# the state" is an explanation, not a declaration. Equally, a string literal holding "@param out" is
# a test fixture, not documentation. Checks that police code read `code_only`, checks that police
# prose read `strip_literals` and keep their own comment anchors, and the handful that inspect
# comment syntax itself read the raw line - each of those is marked where it is defined.
strip_literals() { sed -E 's,"[^"]*","",g'; }

strip_comments() {
    sed -E -e 's,//.*$,,' -e 's,/\*([^*]|\*+[^*/])*\*+/,,g' -e 's,^(\+[[:space:]]*)(\*|/\*).*$,\1,'
}

code_only() { strip_literals | strip_comments; }

#pragma region C, C++, and CUDA

# Discarding a return value through a C-era `(void)expr` cast reads as hiding something and does
# not compose with `[[nodiscard]]`. Bind the value and mark it, or consume it in an if-init.
check_void_discards() {
    local discards
    discards=$(printf '%s\n' "$added" |
        code_only |
        grep -E '\(void\)[[:space:]]*[a-z_]' || true)
    [ -z "$discards" ] || fail "$discards" \
        "$file discards a value through a (void) cast - bind it with [[maybe_unused]] or" \
        "            consume it in an if-init statement:"
}

# Backward-looking prose in comments rots the moment the next rewrite ships and reads as changelog
# noise. Comments describe what the code is and does now; history belongs in commit messages,
# and decision records belong in ROADMAP.md.
#
# `previously` is matched bare, which over-matches algorithm prose - "projections onto
# previously-found eigenvectors" describes deflation state, not code history. Rephrase such a line
# ("already-found") rather than widening the exception list: the alternative is a noun allowlist
# that silently stops catching the real cases as vocabulary drifts.
check_backward_references() {
    local history
    history=$(printf '%s\n' "$added" |
        strip_literals |
        grep -inE '(//|/\*|^\+[[:space:]]*\*).*\b(previously|used to (be|do|work)|no longer|formerly|was replaced|the (old|previous) (design|implementation|version|approach|chain|form)|prior attempt|Phase [0-9])\b' || true)
    [ -z "$history" ] || fail "$history" \
        "$file carries backward-looking prose in a comment - describe the present behavior;" \
        "            history lives in commit messages and ROADMAP.md:"
}

# A run of three or more dashes, equals, hashes, or slashes used as a visual divider carries no
# information the sentence beneath it does not already carry. Sections are named by #pragma region.
check_rulers() {
    local rulers
    rulers=$(printf '%s\n' "$added" |
        grep -E '^\+[[:space:]]*(([#]+|//|\*)[[:space:]]*[-=]{3,}|/{4,}|#{3,})[[:space:]]*$' || true)
    [ -z "$rulers" ] || fail "$rulers" \
        "$file draws a decorative ruler - name the section with #pragma region or write the sentence:"
}

# Every @param declares its direction so a reader knows whether the callee reads, writes, or
# mutates. A bare @param and the comma form @param[in,out] are both rejected; the one spelling
# for a mutated argument is @param[inout].
check_param_directions() {
    local params
    params=$(printf '%s\n' "$added" |
        strip_literals |
        grep -E '@param([[:space:]]+[a-zA-Z_]|\[[[:space:]]*(in[[:space:]]*,|out[[:space:]]*,))' || true)
    [ -z "$params" ] || fail "$params" \
        "$file has an @param without a direction, or uses the comma form - write @param[in]," \
        "            @param[out], or @param[inout]:"
}

# Doxygen renders @b and @c, not Markdown: **bold** and __bold__ inside a comment print literally.
# The underscore arm requires whitespace between the delimiters, which is what separates Markdown
# emphasis from the CUDA and GCC keyword forms - __global__, __restrict__, __LINE__ carry none.
# A single-word __token__ is therefore deliberately not caught: it is indistinguishable from a
# keyword, and widening the pattern to reach it would flag every kernel qualifier in the tree.
check_markdown_doxygen() {
    local emphasis
    emphasis=$(printf '%s\n' "$added" |
        strip_literals |
        grep -E '(//|/\*|^\+[[:space:]]*\*)[^_]*(\*\*[^*]+\*\*|__[a-zA-Z][^_]*[[:space:]][^_]*__)' || true)
    [ -z "$emphasis" ] || fail "$emphasis" \
        "$file uses Markdown emphasis inside a Doxygen comment - use @b for one or two tokens:"
}

# Documentation is /** ... */ only. The ///, //!, and /*! forms fragment the doc style, and //
# is reserved for implementation notes inside function bodies.
check_doc_comment_forms() {
    local forms
    forms=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(///|//!|/\*!)' || true)
    [ -z "$forms" ] || fail "$forms" \
        "$file uses a ///, //!, or /*! doc comment - documentation is /** ... */:"
}

# A member is documented above it, never beside it. A trailing ///< ties the declaration column to
# the longest comment in the struct, so editing one comment re-pads every neighbour, and the prose
# gets whatever width the declaration leaves over instead of the full line.
#
# All four trailing forms are matched, and /**< is the one that matters most: it is Doxygen's
# canonical spelling and the only one consistent with this project's own "documentation is /** ... */"
# rule, so it is what an author following the rest of the style guide reaches for first.
check_trailing_member_docs() {
    local trailing
    trailing=$(printf '%s\n' "$added" | grep -E '(//[!/]|/\*[*!])<' || true)
    [ -z "$trailing" ] || fail "$trailing" \
        "$file documents a member beside it - move the text above the member as /** ... */:"
}

# Nothing in this tree runs Doxygen, so @c, @ref, and @a are markup no reader ever sees. Backticks
# render everywhere and, unlike @c, can span a whole expression rather than a single token - which
# is what @c foo == bar always got wrong.
check_doxygen_symbol_markup() {
    local markup
    markup=$(printf '%s\n' "$added" |
        strip_literals |
        grep -E '@(c|ref|a)[[:space:]]+[A-Za-z_`]' || true)
    [ -z "$markup" ] || fail "$markup" \
        "$file uses @c, @ref, or @a - inline code and symbol names take backticks:"
}

# One space separates sentences. Two is a typewriter habit that survives into diffs as invisible
# churn. Exactly two spaces are matched, so a run of three or more used for column alignment inside
# a comment is left alone.
check_sentence_spacing() {
    local spacing
    spacing=$(printf '%s\n' "$added" |
        strip_literals |
        grep -E '(//|/\*|^\+[[:space:]]*\*).*[a-z0-9)]\.  [A-Z@`]' || true)
    [ -z "$spacing" ] || fail "$spacing" \
        "$file separates sentences with two spaces in a comment - one is enough:"
}

# A one-line doc block is just the sentence. @brief earns its place only in a block long enough to
# have a detail paragraph under it, where it marks which line is the summary.
check_redundant_brief() {
    local briefs
    briefs=$(printf '%s\n' "$added" | grep -E '/\*\*[[:space:]]+@brief[^*]*\*/' || true)
    [ -z "$briefs" ] || fail "$briefs" \
        "$file puts @brief on a one-line doc block - drop it, the sentence is the brief:"
}

# A // comment at column zero sits outside every function body, where it is either documentation or
# a section banner. Documentation is /** ... */, prose that documents no symbol is /* ... */, and a
# section is named by #pragma region. Body comments are indented and so are never matched here.
check_scope_comments() {
    local banners
    banners=$(printf '%s\n' "$added" | grep -E '^\+//[[:space:]]' || true)
    [ -z "$banners" ] || fail "$banners" \
        "$file puts a // comment at namespace scope - use /** */ for a symbol, /* */ for prose," \
        "            or #pragma region for a section:"
}

# Backticks promise something a compiler would accept, so a span carrying a multiplication dot, a
# typographic minus, or a superscript is math wearing a code fence. SMARTS patterns are deliberately
# excluded: they are a real language and none of these characters appear in one.
check_backtick_math() {
    local math
    math=$(printf '%s\n' "$added" |
        strip_literals |
        grep -E '`[^`]*(·|×|−|‖|²|³)[^`]*`' || true)
    [ -z "$math" ] || fail "$math" \
        "$file puts math inside backticks - backticks are for code, state the maths as prose:"
}

# clang-format mis-tokenises a dash inside a region name and reflows around it, so the region
# markers drift out of place on the next format run. Region names are plain words.
check_region_dashes() {
    local regions
    regions=$(printf '%s\n' "$added" | grep -E '#pragma[[:space:]]+(region|endregion)[[:space:]]+.*[][()-]' || true)
    [ -z "$regions" ] || fail "$regions" \
        "$file names a #pragma region with a dash or bracket - use plain words:"
}

# The checked-in .clang-format and .cmake-format.py profiles are the law, so a file formats clean
# as a whole rather than fencing off regions the formatter is told to skip.
#
# This one cannot read `code_only`: the directive is itself a comment, and `strip_comments` would
# delete it before the grep ran. The whole-line anchor takes its place - a real fence occupies its
# own line, while a rationale naming the construct sits inside a sentence.
check_formatter_off() {
    local directives
    directives=$(printf '%s\n' "$added" |
        strip_literals |
        grep -E '^\+[[:space:]]*(//[[:space:]]*clang-format[[:space:]]+(on|off)|#[[:space:]]*cmake-format:[[:space:]]*(on|off))[[:space:]]*$' || true)
    [ -z "$directives" ] || fail "$directives" \
        "$file disables a formatter in-band - the checked-in profiles are the law:"
}

# A container of pointers is a pointer chase plus an allocation per element for something whose
# count is usually known and small. Store values, or store indices into a flat arena.
#
# Arrow is exempt, and only Arrow. `arrow::schema()` and `arrow::Table::Make()` take
# `std::vector<std::shared_ptr<arrow::Field>>` and `...<arrow::Array>>` in their own signatures, so a
# caller cannot pass anything else. That is the same boundary the naming rules already draw around
# RDKit: a shape reached through a library object is that library's, not ours.
check_pointer_containers() {
    local containers
    # Reads code only: a docstring naming RDKit's `std::vector<MMFF*>` parameter column describes
    # someone else's layout rather than declaring ours, and the rule is about what we declare.
    containers=$(printf '%s\n' "$added" |
        code_only |
        grep -v 'std::shared_ptr<arrow::' |
        grep -E '(std::)?(vector|array)[[:space:]]*<[[:space:]]*(std::)?(unique_ptr|shared_ptr)|(std::)?(vector|array)[[:space:]]*<[[:space:]]*(const[[:space:]]+)?[A-Za-z_][A-Za-z_0-9:]*[[:space:]]*(const[[:space:]]*)?\*' || true)
    [ -z "$containers" ] || fail "$containers" \
        "$file holds pointers inside a container - store values, or indices into a flat arena:"
}

# Every quoted include is anchored at a root on the include path, never at the includer's own
# directory. `src/` already works this way, so a sibling header still reads
# `smallfield/preprocess/csd_torsion_native.hpp`. The bare form resolves through the C++ rule that
# `""` searches the includer's directory first, which means the path a reader sees is not the path
# the compiler used, and two includes sitting next to each other silently anchor at different roots.
# Allowed roots: smallfield/ under src/, plus test/, bench/ and cli/ under the repo.
check_include_anchors() {
    local unanchored
    unanchored=$(printf '%s\n' "$added" |
        grep -E '^\+[[:space:]]*#[[:space:]]*include[[:space:]]*"' |
        grep -vE '#[[:space:]]*include[[:space:]]*"(smallfield|test|bench|cli)/' || true)
    [ -z "$unanchored" ] || fail "$unanchored" \
        "$file includes a header by a path relative to itself - anchor it at src/ or the repo root:"
}

# Per-worker state is an explicit rank into caller-owned scratch, not implicit per-thread storage.
# Hidden global state is why prepare_molecule_batch_into cannot be called concurrently today.
check_thread_local() {
    local locals
    locals=$(printf '%s\n' "$added" |
        code_only |
        grep -E '\bthread_local\b' || true)
    [ -z "$locals" ] || fail "$locals" \
        "$file declares thread_local state - pass a caller-owned scratch and a thread rank:"
}

# Positional aggregate initialization silently survives a field insertion or rename: the literal
# keeps compiling and means something else. Past three fields, name them.
#
# A designated initializer is excluded by requiring the first element not to open with a dot, rather
# than by excluding dots everywhere - the earlier form did the latter and so could not see a float
# literal or a member read. Both incidents the rule was written for are float-valued structs, so it
# would have missed the two failures it exists to prevent. Direct initialization is matched too,
# which is the shape the `distance_geometry_energy_functor_t` regression actually took.
check_positional_aggregates() {
    local aggregates
    aggregates=$(printf '%s\n' "$added" |
        code_only |
        grep -vE '^\+[[:space:]]*(enum|struct|class|union|namespace)\b' |
        grep -E '((push_back|emplace_back|emplace)[[:space:]]*\([[:space:]]*|[A-Za-z_][A-Za-z_0-9:]*[[:space:]]+[a-z_][A-Za-z_0-9]*[[:space:]]*)\{[[:space:]]*[^.},[:space:]][^},]*(,[^},]*){3,}\}' || true)
    [ -z "$aggregates" ] || fail "$aggregates" \
        "$file initializes an aggregate positionally past three fields - use designated" \
        "            initializers so a field insertion cannot silently shift the meaning:"
}

# Spell the concept out. A coined short form saves keystrokes once and costs a reader every time.
# Whole-word only, so `rng_state`, `coords_ptr`, and `num_atoms` are untouched - the rule is about
# a bare abbreviation standing alone as a name, not about a segment inside a spelled-out one.
#
# A `/` on either side excludes it: `/tmp/corpus.smi` and `src/smallfield/...` are filesystem
# paths, not identifiers, and this project names both constantly. Matching them taught nothing and
# would have pushed every path string through a bypass.
#
# A preceding `.` or `>` excludes it too, so a member read through a library object is never flagged.
# `crd`, `mltb`, `pilp`, `linh`, and `sbmb` are RDKit's own MMFFProp column names, and CONTRIBUTING.md
# requires that a name reached through a library object keep that library's spelling - so `p.sbmb` is
# mandatory on the right of the adapter boundary while `e.single_bond_multiple_bond` is ours on the
# left. Without this exclusion the rule forbade the only correct way to write that line. The check
# loses nothing by it: a field we declare is caught at its declaration, which is where the name is
# actually chosen, and flagging all 60 downstream reads only buried that one site in noise.
#
# A backtick on either side excludes it for the same reason: `linh` inside a comment is citing the
# MMFFProp column by its published name, which is the informative thing to write, and the field it
# maps onto is already spelled `linear`. Naming a foreign symbol is a citation, not a naming choice.
check_abbreviations() {
    local abbreviations
    abbreviations=$(printf '%s\n' "$added" |
        code_only |
        grep -E '(^|[^/.>`[:alnum:]_])(idx|cfg|tbl|cnt|tmp|buf|ptr|src|dst|nbr|desc|conf|calc|crd|mltb|pilp|linh|sbmb)([^/`[:alnum:]_]|$)' || true)
    [ -z "$abbreviations" ] || fail "$abbreviations" \
        "$file uses an abbreviated identifier - spell it out (index, config, table, count," \
        "            scratch, buffer, pointer, source, destination, neighbor, descriptor, conformer," \
        "            calculate, coordination_number, multiple_bond_designator, pi_lone_pair, linear):"
}

# A binding under four characters makes the reader reconstruct its meaning from context, and this
# tree proved how badly that scales: before the sweep, `a` meant an atom, a neighbour slot, an apex,
# a loop counter and an angle record in one file; `c` was both the current SMARTS character and a
# conjunct index in one parser; `n` was a CSR cursor in one function and MMFF.V equation 18's
# electronegativity exponent in the next. A loop counter names the axis it walks and a contraction
# spells out.
#
# The allowlist holds short words that are not contractions of anything, plus the MMFF spec letters
# that carry meaning the spelled-out form loses: MMFF94 defines a bond over atoms i-j and a torsion
# over i-j-k-l, so `atom_i` maps onto the published equations where `first_atom` does not. Namespace
# aliases are exempt outright - `sft`, `sfp`, `sfc` and their siblings are deliberate, and `fs` and
# `py` are conventional. `lhs`/`rhs` name an operator's two operands, and `dx`/`dy`/`dz` are axes
# rather than abbreviations.
#
# Every addition to this list needs a reason written beside it. A silently growing allowlist is how
# a rule stops catching the thing it was written for.
check_short_identifiers() {
    local short
    # The exempt words are tested against the bound name alone, never against the whole line. A
    # line-wide filter exempts every other binding beside an exempt one.
    #
    # The name is split off with a tab and matched as `[[:space:]]`, because ERE has no `\t` escape
    # and a pattern written that way silently matches a literal `t` instead, exempting nothing.
    #
    # One binding per line is inspected, so `float sum = 0.0f, ab = 1.0f;` is still judged on `sum`
    # alone. Declaring two names on one line is rare here and the fix would cost the diagnostic its
    # line number, which is worth more than the case.
    #
    # The type slot admits a capital, because RDKit, CUDA and Arrow types are the dominant type
    # vocabulary here and a lowercase-only slot made every single-letter binding of one invisible.
    #
    # Statement keywords are dropped first: `return b;` puts `return` in the type slot and `b` in the
    # name slot, which is a statement rather than a declaration.
    #
    # Reads code only: the pattern takes ordinary English for a declaration, so a comment reading
    # "rewrites them from it, so ..." tripped a rule about identifiers. Blanking the comment text
    # rather than dropping the line also keeps `/* fast path */ int n = 0;` in scope.
    short=$(printf '%s\n' "$added" |
        code_only |
        grep -vE '^\+[[:space:]]*(namespace[[:space:]]+[a-z_]+[[:space:]]*=|(return|delete|throw|co_return|co_yield)\b)' |
        sed -nE 's/^(\+.*\b((std::)?[A-Za-z_0-9:]+|auto)[[:space:]]+(const[[:space:]]+)?\*?&?)([a-z][a-z0-9_]{0,2})([[:space:]]*(=|;|\)|,).*)$/\5\t&/p' |
        grep -vE '^(out|end|key|row|dim|hit|ok|top|sum|max|min|raw|bin|tag|on|bit|log|got|now|arg|sha|oop|arc|cis|lhs|rhs|dx|dy|dz|atom_i|atom_j|atom_k|atom_l)[[:space:]]' |
        cut -f2- || true)
    [ -z "$short" ] || fail "$short" \
        "$file binds a name under four characters - name a loop counter for the axis it walks and" \
        "            spell a contraction out; see CONTRIBUTING.md for the exempt words:"
}

# Everything this project declares is snake_case. A camelCase or leading-capital name is either a
# library spelling that leaked into our own declaration, or a habit from another codebase. Library
# names reached through an RDKit, CUDA, or Arrow object keep their spelling and are not matched
# here, because this only inspects a declaration - a type keyword followed by the name it declares.
#
# A name ending in underscore-then-one-capital is an element symbol, not camelCase: this is a
# chemistry codebase and `saw_bare_H` means hydrogen. Spelling it `saw_bare_hydrogen` would be wrong,
# because the parser it belongs to is matching the literal character `H` in a SMARTS token.
check_identifier_case() {
    local cased
    cased=$(printf '%s\n' "$added" |
        code_only |
        grep -E '^\+[[:space:]]*(static |inline |constexpr |const )*(bool|char|short|int|unsigned|float|double|auto|std::[a-z_0-9]+_t|std::size_t)[[:space:]]+(const[[:space:]]+)?([a-z][a-z0-9_]*[A-Z]|[A-Z])[A-Za-z0-9_]*[[:space:]]*[=;,)]' |
        grep -vE '_[A-Z][[:space:]]*[=;,)]' || true)
    [ -z "$cased" ] || fail "$cased" \
        "$file declares a camelCase or leading-capital identifier - everything we declare is" \
        "            snake_case; only names reached through a library object keep their spelling:"
}

# Types carry _t. Without the suffix a reader cannot tell a type from a variable at the use site,
# which is the whole point of carrying one.
#
# A class or struct template is exempt, because it is not a type - it is the thing that makes types.
# The bare noun goes on the template and the _t goes on each concrete specialization, so
# `byte_buffer` yields `pinned_byte_buffer_t` and `device_byte_buffer_t`.
#
# Deciding that needs the line above the declaration, and the added lines alone cannot supply it:
# renaming `byte_buffer_t` to `byte_buffer` stages the `class` line while its `template <...>` head
# stays unchanged context, so a scan of the diff sees a bare type and rejects the very rename this
# rule exists to permit. Both suffix checks therefore look the declaration up in the working file.
declared_under_template_head() { # declared_under_template_head <added-line>
    local text=${1#+} number
    number=$(tr -d '\015' < "$file" 2>/dev/null | grep -nxF -- "$text" | head -1 | cut -d: -f1)
    [ -n "$number" ] && [ "$number" -gt 1 ] || return 1
    tr -d '\015' < "$file" | sed -n "$((number - 1))p" | grep -qE '^[[:space:]]*template[[:space:]]*<'
}

check_type_suffix() {
    local candidates line offenders=""
    candidates=$(printf '%s\n' "$added" |
        grep -E '^\+[[:space:]]*(struct|class|enum([[:space:]]+class)?)[[:space:]]+[a-z][a-z0-9_]*[[:space:]]*(:|\{|$)' |
        grep -vE '_t[[:space:]]*(:|\{|$)' || true)
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        declared_under_template_head "$line" && continue
        offenders="${offenders}${line}"$'\n'
    done <<<"$candidates"
    [ -z "$offenders" ] || fail "$offenders" \
        "$file declares a type without the _t suffix:"
}

# A function's return type is its contract, so it is written rather than deduced. `auto` sends a
# reader to the body and then to whatever the body calls, it is not what a grep for the type finds,
# and it converts a compile error into silent propagation: change what a helper returns, and an
# explicit signature fails at that one accessor while a deduced one carries the new type out through
# every call site with nothing to say so.
#
# A trailing return type is the same promise written on the right, so `auto f() -> span<T>` passes.
# A declaration under a template head is exempt, because there the return may genuinely depend on a
# deduced parameter - `align_up_` returns the width of whatever it was handed, which is its point.
check_deduced_return() {
    local candidates line deduced=""
    candidates=$(printf '%s\n' "$added" |
        grep -E '^\+[[:space:]]*(\[\[nodiscard\]\][[:space:]]*)?(static[[:space:]]+|inline[[:space:]]+|constexpr[[:space:]]+)*auto[[:space:]]+[a-z_][a-z_0-9]*\(' |
        grep -v -- '->' || true)
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        declared_under_template_head "$line" && continue
        deduced="${deduced}${line}"$'\n'
    done <<<"$candidates"
    [ -z "$deduced" ] || fail "$deduced" \
        "$file deduces a function's return type - write it, or give it a trailing return type:"
}

# The other half of the same rule. A class or struct template wearing _t promises a type you can
# declare a variable of, and delivers something you have to supply arguments to first. Name the
# template for what it makes and let each specialization carry the suffix.
check_template_suffix() {
    local candidates line templates=""
    candidates=$(printf '%s\n' "$added" |
        grep -E '^\+[[:space:]]*(struct|class)[[:space:]]+[a-z][a-z0-9_]*_t[[:space:]]*(:|\{|$)' || true)
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        declared_under_template_head "$line" || continue
        templates="${templates}${line}"$'\n'
    done <<<"$candidates"
    [ -z "$templates" ] || fail "$templates" \
        "$file suffixes a class template with _t - _t marks a concrete type, so name the template" \
        "            for what it makes and put the suffix on its specializations:"
}

# Compile-time constants and enumerators carry _k. The Google kFoo prefix is a different project's
# convention and mixing the two means neither reads as a signal.
check_constant_suffix() {
    local constants
    constants=$(printf '%s\n' "$added" |
        grep -E '^\+[[:space:]]*(inline[[:space:]]+|static[[:space:]]+)*constexpr[[:space:]]+[A-Za-z_][A-Za-z0-9_:<>, ]*[[:space:]]+k[A-Z][A-Za-z0-9_]*[[:space:]]*=' || true)
    [ -z "$constants" ] || fail "$constants" \
        "$file names a constant with the Google kFoo prefix - this project suffixes with _k:"
}

# Namespaces mirror the directory structure, so a `detail` namespace names nothing a reader can
# navigate to. An internal helper lives in the file's own namespace with a trailing underscore.
check_detail_namespace() {
    local namespaces
    namespaces=$(printf '%s\n' "$added" |
        grep -E '^\+[[:space:]]*namespace[[:space:]]+detail' || true)
    [ -z "$namespaces" ] || fail "$namespaces" \
        "$file opens a detail namespace - they are banned; give the helper a trailing underscore" \
        "            in the file's own namespace:"
}

# The `g_` prefix ban stays prose in CONTRIBUTING.md and gets no check here. A grep for it fires on
# `g_factor`, the MMFF94 Slater-Kirkwood term, and on `g_trigger` in the torsion equations, and finds
# no real violation anywhere in this tree - `g_` is domain vocabulary in a chemistry codebase, so the
# check would only ever cost false positives.

# Eleven pairs of files here differ only by extension and three of those pairs carry a byte-identical
# @brief, so a bare basename cannot tell a reader which half of a pair they are in. The path is only
# checked when the diff reaches the top of the file, which is where the block lives.
check_file_docblock() {
    case "$added" in
    *"@file"*) ;;
    *) return ;;
    esac
    local declared
    declared=$(printf '%s\n' "$added" | grep -E '@file([[:space:]]|$)' || true)
    [ -z "$declared" ] && return
    printf '%s\n' "$declared" | grep -qF "$file" && return
    fail "$declared" "$file names a different path in its @file - carry the project-relative path:"
}

#pragma endregion C, C++, and CUDA

#pragma region CUDA only

# Fleets of devices are orchestrated with per-device non-blocking streams and events from one host
# thread: kernel launches are already asynchronous, cross-device ordering is cudaStreamWaitEvent,
# and completion is an event-sync loop, so a host thread adds nothing but scheduling noise.
check_host_threads() {
    local threads
    threads=$(printf '%s\n' "$added" |
        code_only |
        grep -E '\bstd::(thread|jthread|async)\b|#include[[:space:]]*<thread>|\bpthread_' || true)
    [ -z "$threads" ] || fail "$threads" \
        "$file spawns host threads in a CUDA source - orchestrate devices with per-device" \
        "            non-blocking cudaStream_t and cudaEvent_t from one host thread:"
}

# cudaMalloc and cudaFree each synchronize the whole device, so under the per-device fan-out every
# allocation on any device serializes against every other device's in-flight work. The stream-ordered
# forms draw from a per-device pool, and the stream carries the device, so a free reaches the context
# that made the allocation without anyone storing a device id.
#
# The open paren is part of the pattern so cudaMallocAsync, cudaFreeAsync and cudaMallocHost - which
# are the replacements - do not match the rule that sends you to them.
check_cuda_allocation() {
    local synchronous
    synchronous=$(printf '%s\n' "$added" |
        code_only |
        grep -E '\bcuda(Malloc|Free)[[:space:]]*\(' || true)
    [ -z "$synchronous" ] || fail "$synchronous" \
        "$file calls cudaMalloc or cudaFree, which synchronize the whole device - use" \
        "            cudaMallocAsync and cudaFreeAsync on the allocator's stream:"
}

# {fmt} has no device-side form, and a header that pulls it in puts it in front of every kernel
# body that includes the header. The rule is a list of function bodies enforced as a rule about
# includes, because that is the part a grep can see.
check_device_header_fmt() {
    local formatting
    formatting=$(printf '%s\n' "$added" |
        grep -E '^\+[[:space:]]*#[[:space:]]*include[[:space:]]*<fmt/' || true)
    [ -z "$formatting" ] || fail "$formatting" \
        "$file is a device header and includes <fmt/...> - take a logger_t const * on the" \
        "            host-side failure path instead, as cuda_error.hpp does:"
}

#pragma endregion CUDA only

#pragma region Library headers

# A bare bool parameter names nothing at the call site: generate(n, true, false) is unreadable.
# A recurring two-state axis earns a two-value enum.
check_boolean_parameters() {
    local booleans
    booleans=$(printf '%s\n' "$added" |
        code_only |
        grep -E '[(,][[:space:]]*bool[[:space:]]+[a-z_]+[[:space:]]*[,)]' || true)
    [ -z "$booleans" ] || fail "$booleans" \
        "$file takes a bare bool parameter - name the choice with a two-value enum:"
}

# The library prints through fmt:: and its own logger. Iostreams are locale-dependent,
# allocation-happy, and verbose; the CLI and tests may still use C stdio.
#
# The rule catches iostream *use*, not the include. RDKit's `AtomTyper.h` names
# `std::stringstream` and `std::cout` without including either, so a header that
# includes it must supply `<sstream>` itself or fail to compile. Banning the include
# would forbid a translation unit from being self-contained, which is the opposite
# of what this check is for.
check_iostreams() {
    local streams
    streams=$(printf '%s\n' "$added" |
        code_only |
        grep -E '\bstd::(cout|cerr|clog|i?fstream|o?fstream|[io]?stringstream)\b' || true)
    [ -z "$streams" ] || fail "$streams" \
        "$file uses an iostream in a library header - print through fmt:: or the project logger:"
}

#pragma endregion Library headers

# clang-format splits a string literal that overruns the column limit, and splits the pieces again
# on the next run, until a word reads "a" "r" "r" "a" "y" "s". Split long literals yourself at a
# sensible boundary and pin each fragment with a trailing `//`.
#
# Comments are blanked but literals are not, since the adjacency this looks for IS the literal.
check_split_literals() {
    local shredded
    shredded=$(printf '%s\n' "$added" |
        strip_comments |
        grep -E '"[A-Za-z0-9_]"[[:space:]]+"|[A-Za-z0-9_]"[[:space:]]+"[A-Za-z0-9_]' || true)
    [ -z "$shredded" ] || fail "$shredded" \
        "$file splits a string literal mid-word - break it yourself and pin each line with a trailing //:"
}

#pragma region Build files

# Three settings that each cost this project real build time, measured rather than assumed.
#
# Interprocedural optimization on a CUDA target switches nvcc from emitting SASS to emitting NVVM
# LTO IR, so every architecture's ptxas codegen moves to the device link - 101.9 s against 0.25 s
# for a plain nvlink, about 84 % of the build, and invisible to ccache because no compiler cache
# caches a device link. Separable compilation earns its keep only when a __device__ function defined
# in one translation unit is referenced from another, which nothing here does.
#
# A CMAKE_<LANG>_FLAGS mutation reaches every target in every subdirectory, and a guard on
# CMAKE_BUILD_TYPE around one is invisible to multi-config generators, where the variable is empty.
# Build settings are interface targets, which are evaluated per configuration.
check_cuda_build_settings() {
    local settings
    settings=$(printf '%s\n' "$added" |
        grep -vE '^\+[[:space:]]*#' |
        grep -E 'INTERPROCEDURAL_OPTIMIZATION|CUDA_SEPARABLE_COMPILATION|set[[:space:]]*\([[:space:]]*CMAKE_(C|CXX|CUDA)_FLAGS' || true)
    [ -z "$settings" ] || fail "$settings" \
        "$file sets IPO, separable compilation, or a global flags variable - build settings are" \
        "            interface targets, and both CUDA settings move ptxas to the device link:"
}

#pragma endregion Build files

#pragma region Shipped tooling

# A run of three or more dashes, equals or hashes inside a string literal is a decorative banner. It
# carries nothing the announcement beside it does not, and it makes two runs of the same binary diff
# noisily. `check_rulers` above covers the comment form; it anchors the whole line and requires a
# comment marker, so it reaches none of these.
#
# Comments are blanked so a Doxygen table drawn with `|---|---|` stays legal; literals are kept,
# because the literal IS what this looks for.
check_output_banners() {
    local banners
    banners=$(printf '%s\n' "$added" |
        strip_comments |
        grep -E '"[^"]*(===|---|###)' || true)
    [ -z "$banners" ] || fail "$banners" \
        "$file prints a decorative banner - one line naming the executable is the whole header:"
}

# Lazy initialization is a function-local `static const`, and nothing else. A magic static already
# runs once, is thread-safe, and retries if the initializer throws, so `call_once` adds a flag and
# no guarantee. Warming third-party state is not an exception: bind the side effect to a
# `static const`. Two near-duplicate RDKit warm-ups each carried their own flag, so the warm-up ran
# twice in one binary -- which is what a second mechanism buys.
check_once_flag() {
    local flags
    flags=$(printf '%s\n' "$added" |
        code_only |
        grep -E 'std::(once_flag|call_once)\b' || true)
    [ -z "$flags" ] || fail "$flags" \
        "$file guards initialization with a once_flag - use a function-local static const:"
}

# An absolute path is a claim about one filesystem, true on the machine that wrote it and silently
# wrong on the next. Every dataset is reached through `data/<name>`, whose entries are symlinks each
# machine makes for itself, so nothing in the tree needs to name a root.
#
# The three binaries that defaulted to corpora under /tmp all defaulted to files that exist on
# nobody's disk, and nothing reported it because a missing corpus read as an empty one.
#
# Comments are NOT blanked here: a docstring example teaches the next reader the wrong habit just as
# effectively as a default does. `${TMPDIR:-/tmp}` is exempt -- that is a portable fallback naming a
# variable, not a path someone typed.
check_absolute_paths() {
    local paths
    paths=$(printf '%s\n' "$added" |
        grep -E '(/mnt/|/home/|/tmp/)' |
        grep -vE 'TMPDIR:-/tmp' || true)
    [ -z "$paths" ] || fail "$paths" \
        "$file names an absolute path - take it as an argument, or reach the share through data/:"
}

#pragma endregion Shipped tooling

#pragma region Markdown

# Emphasis is __bold__ and _italic_, never the asterisk forms, so the rendered and raw text agree
# across every renderer these documents pass through.
check_markdown_asterisks() {
    local emphasis
    # Inline code spans are stripped first: a document that explains this very rule has to
    # name `**bold**` to say it is banned, and inside backticks that is code, not emphasis.
    emphasis=$(printf '%s\n' "$added" | sed 's/`[^`]*`//g' |
        grep -E '\*\*[^*]+\*\*|[^*]\*[A-Za-z][^*]*\*[^*]' || true)
    [ -z "$emphasis" ] || fail "$emphasis" \
        "$file uses asterisk emphasis - bold is __like this__ and italic is _like this_:"
}

#pragma endregion Markdown

# The staged list is computed once and read from a plain file by all three loops below. NUL
# delimiters keep a filename with spaces from splitting, and a file redirect rather than process
# substitution keeps the loop body in this shell without leaning on `/dev/fd`, which is the least
# reliable corner of MSYS.
staged_files=$(mktemp "${TMPDIR:-/tmp}/smallfield-staged-XXXXXX") || exit 0
trap 'rm -f "$staged_files"' EXIT
git diff --cached --name-only --diff-filter=ACM -z > "$staged_files"

# One pass: diff every staged file once and dispatch by extension. Nested `case` rather than the
# `;;&` fallthrough terminator, which is bash 4 and a parse error on the bash 3.2 macOS still ships.
while IFS= read -r -d '' file; do
    # CR is stripped so a CRLF worktree cannot defeat the `$`-anchored patterns. `.gitattributes`
    # pins this repository to LF, but a consumer can override that and the checks should not care.
    added=$(git diff --cached --unified=0 -- "$file" | grep '^+' | grep -v '^+++' | tr -d '\015' || true)
    [ -n "$added" ] || continue
    case "$file" in
    *.c | *.h | *.hpp | *.cpp | *.cc | *.cxx | *.cu | *.cuh)
        check_void_discards
        check_backward_references
        check_rulers
        check_output_banners
        check_once_flag
        check_absolute_paths
        check_param_directions
        check_markdown_doxygen
        check_doc_comment_forms
        check_trailing_member_docs
        check_doxygen_symbol_markup
        check_sentence_spacing
        check_redundant_brief
        check_scope_comments
        check_backtick_math
        check_region_dashes
        check_formatter_off
        check_include_anchors
        check_pointer_containers
        check_thread_local
        check_positional_aggregates
        check_abbreviations
        check_identifier_case
        check_short_identifiers
        check_type_suffix
        check_template_suffix
        check_constant_suffix
        check_detail_namespace
        check_split_literals
        check_file_docblock
        check_cuda_allocation
        check_deduced_return
        case "$file" in
        *.cu | *.cuh) check_host_threads ;;
        esac
        case "$file" in
        src/*.hpp | src/*.cuh)
            check_boolean_parameters
            check_iostreams
            ;;
        esac
        # The device-header set is a list of function bodies {fmt} may not enter, named by the files
        # that carry them: everything under cuda/, every *_device.cuh, and the MMFF table header.
        case "$file" in
        src/smallfield/cuda/* | *_device.cuh | *mmff94_tables_device.cuh)
            check_device_header_fmt
            ;;
        esac
        ;;
    *.md)
        check_markdown_asterisks
        check_absolute_paths
        ;;
    # An absolute path is wrong in a build file, a script or a config for the same reason it is wrong
    # in a source file, so this one rule reaches every text file the project ships.
    #
    # The glob carries `*/` as well as the bare name, because a `case` pattern matches the whole
    # staged path: the bare word reaches the root `CMakeLists.txt` and nothing under `test/`, `cli/`
    # or `bench/`, all three of which exist.
    *.py | *.sh | *.toml | *.json | *.yml | *.yaml | *.cmake | CMakeLists.txt | */CMakeLists.txt)
        check_absolute_paths
        check_cuda_build_settings
        ;;
    # The hooks are extensionless, so no glob above reaches them and they went unchecked by
    # themselves. A rule the enforcement breaks is a rule nobody believes.
    .githooks/*)
        check_absolute_paths
        ;;
    esac
done < "$staged_files"

# Formatter gates. `git clang-format` scores only the changed lines, so legacy formatting is left
# alone and a fresh clone without the tool still commits. cmake-format has no changed-lines mode,
# so it runs whole-file against the checked-in profile.
if command -v git-clang-format > /dev/null 2>&1 && [ -f .clang-format ]; then
    if ! clang-format --version > /dev/null 2>&1; then
        # A toolchain fault is not a lint. `git-clang-format` is a Python script that shells out to
        # `clang-format`, so either half can be missing while the other is on PATH, and reporting
        # that as unformatted code sends the committer hunting for a diagnostic never emitted.
        echo "pre-commit: git-clang-format is installed but clang-format could not run - format gate skipped"
    # Scope it to the languages this profile describes. `git clang-format` also claims
    # `.json` by default, and a `.clang-format` without a Json section makes it exit
    # non-zero on any staged JSON file, which reads here as a formatting failure.
    elif ! git clang-format --staged --diff --quiet --extensions c,h,cc,cpp,hpp,cu,cuh > /dev/null 2>&1; then
        echo "pre-commit: staged C/C++/CUDA lines are not clang-format clean - run \`git clang-format --staged\`"
        failures=$((failures + 1))
    fi
fi

# cmake-format and ruff have no changed-lines mode, so a naive whole-file gate would demand a
# reformat of the entire file to add three lines - the flag day the added-lines discipline exists
# to avoid. Gate on the delta instead: a file that was already unclean at HEAD stays committable,
# but a file that WAS clean may not stop being clean.
# The baseline keeps its original basename inside a scratch directory: both cmake-format and ruff
# pick their parser from the file name, so a `mktemp` name would be checked as the wrong language
# and report clean no matter what it contains.
was_clean_at_head() { # was_clean_at_head <file> <checker-command...>
    local path=$1
    shift
    local scratch baseline clean
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/smallfield-baseline-XXXXXX") || return 0
    baseline="$scratch/$(basename "$path")"
    if ! git show "HEAD:$path" > "$baseline" 2> /dev/null; then
        rm -rf "$scratch" # ? New file: nothing to compare against, so require it clean
        return 0
    fi
    clean=1
    "$@" "$baseline" > /dev/null 2>&1 && clean=0
    rm -rf "$scratch"
    return $clean
}

if command -v cmake-format > /dev/null 2>&1 && [ -f .cmake-format.py ]; then
    while IFS= read -r -d '' file; do
        case "$file" in
        CMakeLists.txt | */CMakeLists.txt | *.cmake) ;;
        *) continue ;;
        esac
        was_clean_at_head "$file" cmake-format --check || continue
        if ! cmake-format --check "$file" > /dev/null 2>&1; then
            echo "pre-commit: $file was cmake-format clean and no longer is - run \`cmake-format -i\`"
            failures=$((failures + 1))
        fi
    done < "$staged_files"
fi

if command -v ruff > /dev/null 2>&1; then
    while IFS= read -r -d '' file; do
        case "$file" in
        *.py) ;;
        *) continue ;;
        esac
        was_clean_at_head "$file" ruff format --check || continue
        if ! ruff format --check "$file" > /dev/null 2>&1; then
            echo "pre-commit: $file was ruff-format clean and no longer is - run \`ruff format\`"
            failures=$((failures + 1))
        fi
    done < "$staged_files"
fi

if [ "$failures" -ne 0 ]; then
    echo ""
    echo "pre-commit: $failures check(s) failed."
    echo "Fix the staged changes and commit again. Bypass knowingly with: git commit --no-verify"
    exit 1
fi
exit 0
