#!/usr/bin/env bash
#
# Feeds known-good and known-bad fixtures through the real `pre-commit` and `commit-msg` and asserts
# the verdict. Run it after touching any check:
#
#     .githooks/selftest
#
# Every check in this file polices text with a regex, and the recurring failure is not a missed
# violation but a false positive on prose: the house style requires a rationale comment above each
# rule, and every rationale names the construct its rule bans. So each rule gets both a fixture that
# must be rejected and a fixture -- usually a comment describing the rule -- that must be accepted.
#
# A rejection only counts when EXACTLY ONE check fired and it was the expected one. Counting is what
# turns the negative cases into false-positive tests too: a fixture tripping two rules means some
# other check is matching text it has no business reading. That is why `pre-commit` prints a count.

set -u
export LC_ALL=C

hooks_dir=$(cd "$(dirname "$0")" && pwd)
scratch_root=${SMALLFIELD_SELFTEST_DIR:-${TMPDIR:-/tmp}/smallfield-selftest}
rm -rf "$scratch_root"
mkdir -p "$scratch_root"
trap 'rm -rf "$scratch_root"' EXIT

passed=0
failed=0

# Each fixture is a throwaway repository outside this tree, with one empty commit so that
# `git diff --cached` has a HEAD to compare against.
new_fixture() {
    local fixture
    fixture=$(mktemp -d "$scratch_root/fixture.XXXXXX")
    git -C "$fixture" init -q
    git -C "$fixture" config user.email selftest@example.com
    git -C "$fixture" config user.name Selftest
    git -C "$fixture" commit -q --allow-empty -m "Add: Baseline"
    mkdir -p "$fixture/src/smallfield" "$fixture/test"
    printf '%s\n' "$fixture"
}

run_precommit() { (cd "$1" && git add -A && "$hooks_dir/pre-commit" 2>&1); }

# Writes one staged file and asserts the hook rejects it for exactly the expected reason.
assert_rejects() { # assert_rejects <title> <path> <content> <expected-substring>
    local title=$1 path=$2 content=$3 expected=$4 fixture output status count
    fixture=$(new_fixture)
    mkdir -p "$fixture/$(dirname "$path")"
    printf '%s\n' "$content" > "$fixture/$path"
    output=$(run_precommit "$fixture")
    status=$?
    count=$(printf '%s\n' "$output" | sed -n 's/^pre-commit: \([0-9]*\) check(s) failed.*/\1/p')
    if [ "$status" -eq 0 ]; then
        printf 'FAIL  %s -- accepted a violation\n' "$title"
        failed=$((failed + 1))
    elif ! printf '%s\n' "$output" | grep -qF "$expected"; then
        printf 'FAIL  %s -- rejected for the wrong reason:\n%s\n' "$title" "$output"
        failed=$((failed + 1))
    elif [ "$count" != "1" ]; then
        printf 'FAIL  %s -- %s checks fired, expected 1:\n%s\n' "$title" "${count:-?}" "$output"
        failed=$((failed + 1))
    else
        printf 'ok    %s\n' "$title"
        passed=$((passed + 1))
    fi
}

assert_accepts() { # assert_accepts <title> <path> <content>
    local title=$1 path=$2 content=$3 fixture output
    fixture=$(new_fixture)
    mkdir -p "$fixture/$(dirname "$path")"
    printf '%s\n' "$content" > "$fixture/$path"
    if output=$(run_precommit "$fixture"); then
        printf 'ok    %s\n' "$title"
        passed=$((passed + 1))
    else
        printf 'FAIL  %s -- rejected clean content:\n%s\n' "$title" "$output"
        failed=$((failed + 1))
    fi
}

assert_message_rejects() { # assert_message_rejects <title> <message> <expected-substring>
    local title=$1 message=$2 expected=$3 path output
    path="$scratch_root/message.$$"
    printf '%s\n' "$message" > "$path"
    output=$("$hooks_dir/commit-msg" "$path" 2>&1)
    if [ $? -eq 0 ]; then
        printf 'FAIL  %s -- accepted a bad message\n' "$title"
        failed=$((failed + 1))
    elif ! printf '%s\n' "$output" | grep -qF "$expected"; then
        printf 'FAIL  %s -- rejected for the wrong reason:\n%s\n' "$title" "$output"
        failed=$((failed + 1))
    else
        printf 'ok    %s\n' "$title"
        passed=$((passed + 1))
    fi
}

assert_message_accepts() { # assert_message_accepts <title> <message>
    local title=$1 message=$2 path output
    path="$scratch_root/message.$$"
    printf '%s\n' "$message" > "$path"
    if output=$("$hooks_dir/commit-msg" "$path" 2>&1); then
        printf 'ok    %s\n' "$title"
        passed=$((passed + 1))
    else
        printf 'FAIL  %s -- rejected a good message:\n%s\n' "$title" "$output"
        failed=$((failed + 1))
    fi
}

# Every rationale comment in the hook names the construct its rule bans, so each of these was a
# verified false positive before the checks read `code_only`.
assert_accepts "a comment naming thread_local" src/smallfield/note.hpp \
    '/* A thread_local cache would hide the state, so a rank into caller-owned scratch is passed. */'
assert_accepts "a comment naming std::cout" src/smallfield/note.hpp \
    '/* RDKit prints its warnings through std::cerr, which the caller redirects. */'
assert_accepts "a comment naming a (void) cast" src/smallfield/note.hpp \
    '/* A (void) cast hides the failure, so the value is bound instead. */'
assert_accepts "a comment naming std::thread" src/smallfield/note.cu \
    '/* Device fleets avoid std::thread; per-device streams carry the ordering. */'
assert_accepts "a comment naming a bool parameter" src/smallfield/note.hpp \
    '/* Never write generate(count, bool strict) - name the choice with an enum. */'
assert_accepts "a string literal holding @param" src/smallfield/note.hpp \
    'char const *doc_fixture = "@param out the result";'
assert_accepts "a string literal holding @c markup" src/smallfield/note.hpp \
    'parser.parse("@c value");'
assert_accepts "a comment naming an abbreviation" src/smallfield/note.hpp \
    '/* Spell it out: idx becomes index and tmp becomes scratch. */'
assert_accepts "prose that reads as a declaration" src/smallfield/note.hpp \
    '/* The workflow rewrites them from it, so nothing here is edited by hand. */'

# The same rules must still fire on real code.
assert_rejects "a real thread_local declaration" src/smallfield/note.hpp \
    'thread_local int counter = 0;' "declares thread_local state"
assert_rejects "a real (void) discard" src/smallfield/note.hpp \
    '(void) compute_something();' "discards a value through a (void) cast"
assert_rejects "a real iostream use" src/smallfield/note.hpp \
    'std::cout << value;' "uses an iostream in a library header"
assert_rejects "a real bare bool parameter" src/smallfield/note.hpp \
    'void generate(int count, bool strict);' "takes a bare bool parameter"
assert_rejects "a real abbreviated identifier" src/smallfield/note.hpp \
    'int desc = 0;' "uses an abbreviated identifier"
assert_rejects "a real detail namespace" src/smallfield/note.hpp \
    'namespace detail {' "opens a detail namespace"
assert_rejects "a real unanchored include" src/smallfield/note.hpp \
    '#include "sibling.hpp"' "includes a header by a path relative to itself"
assert_rejects "a real decorative ruler" src/smallfield/note.hpp \
    '    // =========================' "draws a decorative ruler"
assert_rejects "a real backward-looking comment" src/smallfield/note.hpp \
    '/* This field is no longer used by the packer. */' "carries backward-looking prose"

# The banner rule reaches the string-literal form that `check_rulers` cannot: that one anchors the
# whole line and requires a comment marker, so every banner a binary actually prints slips past it.
assert_rejects "a decorative banner in printed output" bench/note.cpp \
    '    fmt::println("=== System B: SmallField GPU ===");' "prints a decorative banner"
assert_accepts "a Doxygen table drawn with dashes" cli/note.hpp \
    ' *  |----------|-------|'
assert_rejects "a once_flag guarding initialization" cli/note.cpp \
    '    static std::once_flag flag;' "guards initialization with a once_flag"
assert_accepts "a comment explaining why once_flag is banned" cli/note.cpp \
    '    // A std::call_once here would add a flag and no guarantee a magic static lacks.'
assert_rejects "an absolute path in a source file" bench/note.cpp \
    '    std::string corpus = "/tmp/chembl_valid.smi";' "names an absolute path"
# A docstring example teaches the next reader the wrong habit as effectively as a default does, so
# this rule is the one that does NOT blank comments before matching.
assert_rejects "an absolute path in a docstring example" bench/note.py \
    '#     python validate_parquet.py --input /tmp/usearch_10M_3D' "names an absolute path"
assert_accepts "a relative path under data/" bench/note.py \
    '#     python validate_parquet.py --input data/usearch-molecules/pubchem/3d'

# A violation sharing a line with a leading comment must still be caught. Blanking comment text
# rather than dropping the whole line is what makes this reachable.
assert_rejects "a violation behind a leading comment" src/smallfield/note.hpp \
    '/* fast path */ thread_local int counter = 0;' "declares thread_local state"

# Every case below covers a check that had no fixture and was therefore broken in a way nobody saw.
# The correlation was exact: each total failure sat in the no-fixture column.

# `/**<` is Doxygen's canonical trailing form and the one this project's own /** */ rule leads an
# author to, and it was the one form the pattern missed.
assert_rejects "a trailing member doc in the canonical form" src/smallfield/note.hpp \
    '    std::uint32_t atom_count; /**< atoms in this molecule */' "documents a member beside it"

# The emphasis gap could not consume the third star of a /** opener, so it was blind to the opening
# line of every doc block in the project.
assert_rejects "Markdown emphasis in a single-line doc block" src/smallfield/note.hpp \
    '/** __bits that must not be set__ are cleared here. */' "uses Markdown emphasis"

# This one read `code_only`, whose first step deletes `//...`, so the clang-format arm could never
# fire on the directive it exists to catch.
assert_rejects "an in-band clang-format fence" src/smallfield/note.hpp \
    '    // clang-format off' "disables a formatter in-band"
assert_accepts "prose naming a clang-format fence" src/smallfield/note.hpp \
    '/* A // clang-format off fence would hide the reflow, so the profile stays the law. */'

# Excluding dots everywhere also excluded float literals, so the check would have missed both
# incidents it was written for - each was a float-valued struct.
assert_rejects "a positional aggregate of float literals" src/smallfield/note.hpp \
    '    terms.push_back({1.0f, 2.0f, 3.0f, 4.0f});' "initializes an aggregate positionally"
assert_accepts "a designated initializer past three fields" src/smallfield/note.hpp \
    '    terms.push_back({.atom_i = 1, .atom_j = 2, .atom_k = 3, .angle = 4.0f});'
assert_accepts "an enum class listing four enumerators" src/smallfield/note.hpp \
    'enum class term_kind_t { bond_k, angle_k, torsion_k, nonbonded_k };'

# `return` landed in the type slot and the bound value in the name slot, so a short return rejected
# the commit; and the exempt words filtered the whole line rather than the bound name.
assert_accepts "a short return value" src/smallfield/note.hpp \
    '    return b;'
assert_rejects "a single-letter binding of a capitalized type" src/smallfield/note.hpp \
    '    RDKit::ROMol *m = molecule.get();' "binds a name under four characters"

# Stream-ordered allocation, and the two forms that replace the banned ones.
assert_rejects "a synchronous device allocation" src/smallfield/note.cu \
    '    cudaMalloc(&device_pool, total_bytes);' "calls cudaMalloc or cudaFree"
assert_accepts "a stream-ordered device allocation" src/smallfield/note.cu \
    '    cudaMallocAsync(&device_pool, total_bytes, stream);'

assert_rejects "fmt reaching a device header" src/smallfield/cuda/note.cuh \
    '#include <fmt/format.h>' "is a device header and includes"

# The glob was the bare word, so every CMakeLists.txt outside the root went unchecked.
assert_rejects "interprocedural optimization in a subdirectory build file" test/CMakeLists.txt \
    'set_target_properties(smallfield_test PROPERTIES INTERPROCEDURAL_OPTIMIZATION ON)' \
    "sets IPO, separable compilation, or a global flags variable"

assert_rejects "an @file naming another file" src/smallfield/note.hpp \
    '/** @file src/smallfield/other.hpp */' "names a different path in its @file"

# A deduced return type sends a reader to the body, hides from grep, and turns a change in one helper
# into silent propagation through every accessor that forwards it.
assert_rejects "a deduced return type on an accessor" src/smallfield/note.hpp \
    '    auto etk_torsions() const noexcept { return region<etk_torsion_descriptor_t>(offset, count); }' \
    "deduces a function's return type"
assert_accepts "a trailing return type" src/smallfield/note.hpp \
    'inline auto make_view() -> custd::span<float> { return {}; }'
assert_accepts "a deduced return under a template head" src/smallfield/note.hpp \
    'template <typename value_, typename alignment_>
constexpr auto align_up_(value_ value, alignment_ alignment) noexcept {
    return value + alignment;
}'

# Markdown emphasis, and the document that has to name the banned form to ban it.
assert_rejects "asterisk emphasis in Markdown" NOTES.md \
    'This is **bold** text.' "uses asterisk emphasis"
assert_accepts "a Markdown document naming the banned form" NOTES.md \
    'Bold is `**bold**` in other dialects; here it is __bold__.'

# The backward-reference rule reaches prose, not just C++ comments. Markdown is prose on every line;
# Python carries it behind `#` and inside docstrings, which is why that arm keeps its literals.
assert_rejects "backward-looking prose in Markdown" NOTES.md \
    'The packer no longer reads this field.' "carries backward-looking prose"
assert_rejects "backward-looking prose in a Python comment" bench/note.py \
    '# The packer no longer reads this field.' "carries backward-looking prose"
assert_rejects "backward-looking prose in a Python docstring" bench/note.py \
    '"""The packer no longer reads this field."""' "carries backward-looking prose"
assert_accepts "a Markdown document naming the banned words" NOTES.md \
    'No "previously", "used to", "no longer" in prose.'
assert_accepts "a changelog, which narrates history by definition" CHANGELOG.md \
    'The packer no longer reads this field.'
assert_accepts "a roadmap, which records decisions" ROADMAP.md \
    'The packer no longer reads this field.'

# One sentence per line, and the bullet whose bold lead-in ends in a period is still one sentence.
assert_rejects "several sentences on one Markdown line" NOTES.md \
    'The reader owns the queue. The writer drains it.' "packs several sentences onto one line"
assert_accepts "a term-then-definition bullet" NOTES.md \
    '- __Style checks in CI.__ CI is for correctness.'

# A clean tree must commit untouched. Deliberately adversarial: a path that looks like an
# abbreviation, a SMARTS pattern, an RDKit column name behind the adapter boundary, and a template
# whose bare name is correct precisely because it is a template.
assert_accepts "an adversarial but clean header" src/smallfield/clean.hpp \
    '#pragma once

#include "smallfield/types/molecule_descriptor.hpp"

namespace smallfield {

/** Reads the corpus at `data/corpus.smi` and matches `[O:1]=[C:2]!@;-[O:3]`. */
template <typename allocator_>
class byte_buffer {
    std::size_t count = 0;
};

using pinned_byte_buffer_t = byte_buffer<pinned_alloc_t>;

inline constexpr int max_atoms_k = 128;

} // namespace smallfield'

assert_message_accepts "a conforming subject" "Improve: Split the preprocess headers by consumer"
assert_message_rejects "an assistant trailer" \
    "Add: Something

Co-authored-by: Claude <noreply@anthropic.com>" "AI-assistant attribution"

printf '\n%d passed, %d failed\n' "$passed" "$failed"
[ "$failed" -eq 0 ]
