# Conservative clang-tidy configuration for a CUDA + RDKit pipeline. Device code and
# intrinsics-heavy kernels trigger many false positives in the broader checkers, so the
# enabled set stays narrow and focused on real bugs.
#
# Advisory, not a gate: `WarningsAsErrors` is empty and no Git hook runs this. Style is
# enforced by `.githooks/pre-commit`. Run this by hand when you want a second opinion:
#
#   cmake --preset dev
#   clang-tidy-20 -p build_dev --config-file=.clang-tidy cli/parquet_writer.cpp
#
# `--config-file` is not optional and not a convenience. An auto-discovered `.clang-tidy`
# has its `HeaderFilterRegex` silently ignored, so every header diagnostic is suppressed --
# and `src/smallfield/` is 49 headers against one `.cpp`, so the discovered form can say
# essentially nothing about the library. `--header-filter=` on the command line works too.
# Name a `.cpp` rather than a header: a header is in no compilation database, so the command
# is guessed, and the guess misses `-fopenmp` and fails on `omp.h`.

Checks: >
  -*,
  clang-analyzer-*,
  clang-diagnostic-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-assignment-in-if-condition,
  -bugprone-casting-through-void,
  -bugprone-macro-parentheses,
  -bugprone-branch-clone,
  -bugprone-empty-catch,
  misc-redundant-expression,
  misc-unused-using-decls,
  performance-*,
  -performance-avoid-endl,
  -performance-enum-size,
  readability-duplicate-include,
  readability-misleading-indentation,
  readability-redundant-preprocessor,

# `clang-diagnostic-*` and `clang-analyzer-*` are named back in because the leading `-*` removes
# them: they are prepended to the list rather than being on by default, so without these two lines
# clang-tidy discards the `-Wconversion` the compile command already carries and never runs the
# analyzer at all.
#
# `performance-enum-size` is off because it fires on the scoped enums this project's naming rule
# mandates, including ones deliberately word-sized for device code. `bugprone-branch-clone` is off
# because one enumerator per case is the house form. `bugprone-empty-catch` is off because every
# such catch here carries a comment saying why the skip is deliberate.

WarningsAsErrors: ''

# Our four roots, with the dependencies named explicitly rather than excluded by a narrow include.
HeaderFilterRegex: '.*/(src/smallfield|cli|bench|test)/.*'
ExcludeHeaderFilterRegex: '.*/(\.pixi|/usr/include|/usr/local/cuda)/.*'

FormatStyle: file
CheckOptions:
  - key: bugprone-assert-side-effect.AssertMacros
    value: 'assert,sf_assert_,sf_verify_'
