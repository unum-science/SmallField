{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "description": "One architecture, detected from the local GPU. The inner loop.",
      "binaryDir": "${sourceDir}/build_dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SMALLFIELD_CUDA_ARCH": "native",
        "SMALLFIELD_MARCH_NATIVE": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "One architecture, no NDEBUG. The only preset where `sf_assert_` is live.",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build_debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "The full 80/89/90/100/120 fatbin, which is what ships.",
      "binaryDir": "${sourceDir}/build_release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "profile",
      "displayName": "Profiling",
      "description": "Release plus CUDA line info for `ncu` and NVTX ranges for `nsys` role timelines.",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build_profile",
      "cacheVariables": {
        "SMALLFIELD_CUDA_LINEINFO": "ON",
        "SMALLFIELD_USE_NVTX": "ON",
        "SMALLFIELD_MARCH_NATIVE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "profile",
      "configurePreset": "profile"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
