{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "description": "One architecture, detected from the local GPU. The inner loop.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SMALLFIELD_CUDA_ARCH": "native"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "The full 80/89/90/100/120 fatbin, which is what ships.",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "profile",
      "displayName": "Profiling",
      "description": "Release plus CUDA line info, so `ncu` can attribute stalls to source lines.",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build-profile",
      "cacheVariables": {
        "SMALLFIELD_CUDA_LINEINFO": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "profile",
      "configurePreset": "profile"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
