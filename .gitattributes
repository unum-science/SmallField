# Normalize every text file to LF in the repository and check it out as LF on every platform.
# Git for Windows turns `core.autocrlf` on by default, and a CRLF checkout gives `.githooks/*` a
# shebang ending in a carriage return, at which point every hook exits 127 and no check runs at all.
# `eol=lf` is the operative half - `text=auto` alone still yields CRLF worktrees there. Binary
# content is detected automatically and left alone.
* text=auto eol=lf

# Force GitHub linguist to classify CUDA files as Cuda, not C++.
*.cu  linguist-language=Cuda
*.cuh linguist-language=Cuda

# Keep vendored / generated / profiling trees out of language stats and diff noise.
.venv/      linguist-vendored=true
build/      linguist-generated=true
benchmark/  linguist-generated=true
analysis/   linguist-generated=true

# Treat common non-source artefacts as text for diff readability.
*.smi text
*.md  text eol=lf
